# Mẫu cấu hình API Keys cho dự án (Dùng để chia sẻ trên Git)
# Tạo file .env và điền các khóa API thực tế của bạn vào đó:

EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here
EXPO_PUBLIC_GROQ_API_KEY=your_groq_api_key_here
EXPO_TOKEN=your_expo_access_token_here
# HiveMQ Cloud MQTT Broker (WebSocket Secure)
EXPO_PUBLIC_MQTT_HOST=your_cluster_id.s1.eu.hivemq.cloud
EXPO_PUBLIC_MQTT_PORT=8884
EXPO_PUBLIC_MQTT_PATH=/mqtt
EXPO_PUBLIC_MQTT_USERNAME=your_username
EXPO_PUBLIC_MQTT_PASSWORD=your_password
